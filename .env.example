# ─────────────────────────────────────────────────────────────────
# MindfulSpace — Environment Variables
# ─────────────────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your real values below
# 3. NEVER commit .env to Git — it's in .gitignore
# ─────────────────────────────────────────────────────────────────

# ── Flask ──
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_flask_secret_key_here

# ── Gemini AI (Google) ──
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: swap to gemini-1.5-pro for richer responses (uses more quota)
GEMINI_MODEL=gemini-1.5-flash

# ── Google Calendar — Therapist / Supporter Calendar IDs ──
# Each value is the therapist's Google Calendar ID (usually their Gmail address)
# Find it: calendar.google.com → Settings → [Calendar name] → Calendar ID
GOOGLE_CALENDAR_T1=dr.mitchell@yourcollege.edu
GOOGLE_CALENDAR_T2=dr.okafor@yourcollege.edu
GOOGLE_CALENDAR_T3=dr.sharma@yourcollege.edu
GOOGLE_CALENDAR_P1=leo.thompson@yourcollege.edu
GOOGLE_CALENDAR_P2=amara.diallo@yourcollege.edu
GOOGLE_CALENDAR_P3=kai.nakamura@yourcollege.edu

# ── Calendly (optional — only needed if using Calendly integration) ──
# CALENDLY_API_KEY=your_calendly_api_key_here
# CALENDLY_WEBHOOK_SIGNING_KEY=your_calendly_webhook_signing_key_here

# ─────────────────────────────────────────────────────────────────
# Setup notes:
#   credentials.json  → follow instructions in credentials.json.example
#   token.json        → auto-generated when you run /gcal-auth
#   Both files are gitignored and should NEVER be committed.
# ─────────────────────────────────────────────────────────────────
